# Copy this file to .env and paste your keys after the = signs.
# .env is in .gitignore, so your keys never go to GitHub. Never put keys in this example file.

# Claude: reads camera/business photos, and (with LLM_AGENTS=1) writes the agents' arguments
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# The agents make many short calls, so a faster model keeps negotiations snappy
AGENT_MODEL=claude-haiku-5-5
LLM_AGENTS=1

# ElevenLabs: the agents speak their debate, and shelters hear requests and answer by voice
ELEVENLABS_API_KEY=
# Optional: pick voices by ID (otherwise Uplink picks four different voices from your account)
# ELEVEN_VOICE_SPEED=
# ELEVEN_VOICE_COST=
# ELEVEN_VOICE_NEED=
# ELEVEN_VOICE_DISPATCH=
# ELEVEN_VOICE_SHELTER=

# AGNTCY: run the shelter and driver agents as A2A agents over NATS (pip install -r requirements-agntcy.txt,
# then start a NATS server with: nats-server). Leave off to run them in-process.
# AGNTCY=1
# NATS_URL=nats://localhost:4222
